rules_version = '2';

// Paste into Firebase Console > Firestore > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'roles', 'systems', 'platforms', 'cityCode',
                               'district', 'bio', 'ageConfirmed', 'createdAt', 'updatedAt'])
        && d.nickname is string && d.nickname.size() >= 2 && d.nickname.size() <= 30
        && d.roles is list && d.roles.size() >= 1 && d.roles.hasOnly(['player', 'dm'])
        && d.systems is list && d.systems.size() >= 1 && d.systems.size() <= 20
        && d.platforms is list && d.platforms.size() >= 1
        && d.platforms.hasOnly(['in_person', 'discord', 'roll20', 'foundry', 'zoom', 'other'])
        && (d.cityCode == null || (d.cityCode is int && d.cityCode >= 1 && d.cityCode <= 81))
        && (d.district == null || (d.district is string && d.district.size() <= 40))
        && d.bio is string && d.bio.size() <= 500
        && d.ageConfirmed == true
        && d.updatedAt == request.time;
    }

    // Public profiles: any signed-in user can read, only the owner can write.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }
  }
}
