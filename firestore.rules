rules_version = '2';

// Paste into Firebase Console > Firestore > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Keep in sync with lib/features/profile/nickname.dart.
    function validNickname(n) {
      return n is string && n.size() >= 3 && n.size() <= 24
        && n.matches('[A-Za-z0-9]+([ ._][A-Za-z0-9]+)*')
        && nickKey(n).size() >= 3;
    }

    function nickKey(n) {
      return n.lower().replace('[ ._]', '');
    }

    function nicknamePath(key) {
      return /databases/$(database)/documents/nicknames/$(key);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'roles', 'systems', 'platforms', 'cityCode',
                               'district', 'bio', 'ageConfirmed', 'createdAt', 'updatedAt'])
        && validNickname(d.nickname)
        // The nickname must be reserved by this user (in the same write).
        && getAfter(nicknamePath(nickKey(d.nickname))).data.uid == request.auth.uid
        && d.roles is list && d.roles.size() >= 1 && d.roles.hasOnly(['player', 'dm'])
        && d.systems is list && d.systems.size() >= 1 && d.systems.size() <= 40
        && d.platforms is list && d.platforms.size() >= 1
        && d.platforms.hasOnly(['in_person', 'discord', 'roll20', 'foundry', 'zoom', 'other'])
        && (d.cityCode == null || (d.cityCode is int && d.cityCode >= 1 && d.cityCode <= 81))
        && (d.district == null || (d.district is string && d.district.size() <= 40))
        && d.bio is string && d.bio.size() <= 500
        && d.ageConfirmed == true
        && d.updatedAt == request.time;
    }

    // When the nickname changes, the old reservation must be released.
    function oldNicknameReleased() {
      let oldNick = resource.data.nickname;
      return !validNickname(oldNick)
        || nickKey(oldNick) == nickKey(request.resource.data.nickname)
        || !existsAfter(nicknamePath(nickKey(oldNick)));
    }

    // Public profiles: any signed-in user can read, only the owner can write.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile() && oldNicknameReleased()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid)
        && (!validNickname(resource.data.nickname)
            || !existsAfter(nicknamePath(nickKey(resource.data.nickname))));

      // Users this user blocked. Private to the owner.
      match /blocked/{otherUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && otherUid != uid
          && request.resource.data.keys().hasOnly(['nickname', 'createdAt'])
          && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
          && request.resource.data.createdAt == request.time;
      }
    }

    // True if user `a` has blocked user `b`.
    function hasBlocked(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b));
    }

    // Reports: create-only for users; reviewed in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'targetUid',
                                                 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['user', 'game', 'seeker']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200
        && request.resource.data.targetUid is string && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'fake', 'other']
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    function gamePath(gameId) {
      return /databases/$(database)/documents/games/$(gameId);
    }

    function validGame() {
      let d = request.resource.data;
      let owner = get(userPath(request.auth.uid)).data;
      return d.keys().hasOnly(['ownerUid', 'ownerNickname', 'title', 'system', 'platform',
                               'cityCode', 'district', 'gameType', 'campaignStage', 'frequency',
                               'sessionAt', 'seatsTotal', 'seatsOpen', 'language',
                               'beginnerFriendly', 'paid', 'price', 'currency', 'description',
                               'status', 'createdAt', 'updatedAt'])
        && d.ownerUid == request.auth.uid
        && 'dm' in owner.roles
        // Current nickname, or unchanged (the DM may have renamed since posting).
        && (d.ownerNickname == owner.nickname
            || (resource != null && d.ownerNickname == resource.data.ownerNickname))
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.system is string && d.system.size() >= 1 && d.system.size() <= 30
        && d.platform in ['in_person', 'discord', 'roll20', 'foundry', 'zoom', 'other']
        && (d.platform != 'in_person'
            || (d.cityCode is int && d.cityCode >= 1 && d.cityCode <= 81
                && d.district is string && d.district.size() >= 1 && d.district.size() <= 40))
        && (d.platform == 'in_person' || (d.cityCode == null && d.district == null))
        && d.gameType in ['one_shot', 'campaign']
        && (d.gameType == 'campaign'
            ? (d.campaignStage in ['new', 'ongoing']
               && d.frequency in ['weekly', 'biweekly', 'monthly', 'irregular'])
            : (d.campaignStage == null && d.frequency == null))
        && (d.sessionAt == null || d.sessionAt is timestamp)
        && d.seatsTotal is int && d.seatsTotal >= 1 && d.seatsTotal <= 12
        && d.seatsOpen is int && d.seatsOpen >= 0 && d.seatsOpen <= d.seatsTotal
        && d.language in ['tr', 'en']
        && d.beginnerFriendly is bool
        && d.paid is bool
        && (d.paid ? (d.price is int && d.price >= 1 && d.price <= 100000) : d.price == null)
        && d.currency == 'TRY'
        && d.description is string && d.description.size() <= 2000
        && d.status in ['open', 'full', 'closed']
        && d.updatedAt == request.time;
    }

    // Game listings: public to signed-in users; only DMs create, only the owner edits.
    match /games/{gameId} {
      allow read: if signedIn();
      allow create: if signedIn() && validGame() && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && validGame()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Private contact note: the owner and accepted players can read it.
      match /private/{docId} {
        allow read: if signedIn()
          && (get(gamePath(gameId)).data.ownerUid == request.auth.uid
              || get(/databases/$(database)/documents/games/$(gameId)/applications/$(request.auth.uid))
                   .data.status == 'accepted');
        allow create, update: if signedIn() && docId == 'contact'
          && getAfter(gamePath(gameId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['note'])
          && request.resource.data.note is string && request.resource.data.note.size() <= 500;
        // Also allowed when the game is deleted in the same batch.
        allow delete: if signedIn() && get(gamePath(gameId)).data.ownerUid == request.auth.uid;
      }

      // Applications: games/{gameId}/applications/{applicantUid}, one per player.
      // Reads are handled by the collection-group match below.
      match /applications/{applicantUid} {
        allow create: if signedIn() && request.auth.uid == applicantUid && validNewApplication(gameId);
        allow update: if signedIn()
          && (applicantUpdate(gameId, applicantUid) || ownerUpdate(gameId));
        // The game owner (deleting the game) or the applicant (deleting their account).
        allow delete: if signedIn()
          && (request.auth.uid == applicantUid || get(gamePath(gameId)).data.ownerUid == request.auth.uid);
      }
    }

    function validNewApplication(gameId) {
      let d = request.resource.data;
      let game = get(gamePath(gameId)).data;
      let me = get(userPath(request.auth.uid)).data;
      return d.keys().hasOnly(['gameId', 'gameTitle', 'gameOwnerUid', 'applicantUid',
                               'applicantNickname', 'message', 'status', 'createdAt', 'updatedAt'])
        && game.status == 'open'
        && game.ownerUid != request.auth.uid
        && !hasBlocked(game.ownerUid, request.auth.uid)
        && 'player' in me.roles
        && d.gameId == gameId
        && d.gameTitle == game.title
        && d.gameOwnerUid == game.ownerUid
        && d.applicantUid == request.auth.uid
        && d.applicantNickname == me.nickname
        && d.message is string && d.message.size() <= 500
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    // Applicant: withdraw (pending/accepted -> withdrawn) or re-apply (withdrawn -> pending).
    function applicantUpdate(gameId, applicantUid) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return request.auth.uid == applicantUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'message', 'updatedAt'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.updatedAt == request.time
        && ((before in ['pending', 'accepted'] && after == 'withdrawn')
            || (before == 'withdrawn' && after == 'pending'
                && get(gamePath(gameId)).data.status == 'open'));
    }

    // Game owner: accept/reject pending applications, or remove an accepted player.
    function ownerUpdate(gameId) {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return get(gamePath(gameId)).data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((before == 'pending' && after in ['accepted', 'rejected'])
            || (before == 'accepted' && after == 'removed'));
    }

    // "Looking for group" posts. IDs are {uid}_1..3, which caps each player at three.
    function validSeeker(postId) {
      let d = request.resource.data;
      let me = get(userPath(request.auth.uid)).data;
      return d.keys().hasOnly(['ownerUid', 'ownerNickname', 'systems', 'platforms', 'cityCode',
                               'district', 'gameTypes', 'languages', 'experience', 'availability',
                               'openToPaid', 'description', 'status', 'createdAt', 'updatedAt'])
        && d.ownerUid == request.auth.uid
        && postId in [request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3']
        && 'player' in me.roles
        && (d.ownerNickname == me.nickname
            || (resource != null && d.ownerNickname == resource.data.ownerNickname))
        && d.systems is list && d.systems.size() >= 1 && d.systems.size() <= 40
        && d.platforms is list && d.platforms.size() >= 1
        && d.platforms.hasOnly(['in_person', 'discord', 'roll20', 'foundry', 'zoom', 'other'])
        && ('in_person' in d.platforms
            ? (d.cityCode is int && d.cityCode >= 1 && d.cityCode <= 81
               && d.district is string && d.district.size() >= 1 && d.district.size() <= 40)
            : (d.cityCode == null && d.district == null))
        && d.gameTypes is list && d.gameTypes.size() >= 1 && d.gameTypes.hasOnly(['one_shot', 'campaign'])
        && d.languages is list && d.languages.size() >= 1 && d.languages.hasOnly(['tr', 'en'])
        && d.experience in ['new', 'some', 'veteran']
        && d.availability is string && d.availability.size() <= 100
        && d.openToPaid is bool
        && d.description is string && d.description.size() <= 1000
        && d.status in ['open', 'closed']
        && d.updatedAt == request.time;
    }

    match /seekers/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && validSeeker(postId) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && validSeeker(postId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Invitations: invites/{gameId}_{playerUid}. A DM invites a player to one of
    // their open games; the player applies as usual or dismisses it.
    function validInvite(inviteId) {
      let d = request.resource.data;
      let game = get(gamePath(d.gameId)).data;
      return d.keys().hasOnly(['gameId', 'gameTitle', 'dmUid', 'dmNickname', 'playerUid', 'status', 'createdAt'])
        && d.gameId is string && d.playerUid is string
        && inviteId == d.gameId + '_' + d.playerUid
        && d.dmUid == request.auth.uid
        && game.ownerUid == request.auth.uid
        && game.status == 'open'
        && d.gameTitle == game.title
        && d.dmNickname == get(userPath(request.auth.uid)).data.nickname
        && d.playerUid != request.auth.uid
        && 'player' in get(userPath(d.playerUid)).data.roles
        && !hasBlocked(d.playerUid, request.auth.uid)
        // Not if the player already applied (or was rejected/removed); withdrawn is fine.
        && (!exists(applicationPath(d.gameId, d.playerUid))
            || get(applicationPath(d.gameId, d.playerUid)).data.status == 'withdrawn')
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    function applicationPath(gameId, uid) {
      return /databases/$(database)/documents/games/$(gameId)/applications/$(uid);
    }

    match /invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.playerUid == request.auth.uid || resource.data.dmUid == request.auth.uid);
      allow create: if signedIn() && validInvite(inviteId);
      // The player can only dismiss a pending invitation.
      allow update: if signedIn() && resource.data.playerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending' && request.resource.data.status == 'dismissed';
      allow delete: if signedIn()
        && (resource.data.dmUid == request.auth.uid || resource.data.playerUid == request.auth.uid);
    }

    // Chats: chats/{uidA}_{uidB} (UIDs sorted) with messages below.
    // A chat can only be started from a listing:
    //  - game: messaging the game's DM, or the DM messaging someone who applied;
    //  - seeker: a DM messaging the owner of a "looking for group" post.
    function chatOther(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function validChatContext(d, other) {
      return (d.contextType == 'game'
              && d.contextTitle == get(gamePath(d.contextId)).data.title
              && (get(gamePath(d.contextId)).data.ownerUid == other
                  || (get(gamePath(d.contextId)).data.ownerUid == request.auth.uid
                      && exists(applicationPath(d.contextId, other)))))
        || (d.contextType == 'seeker'
            && get(/databases/$(database)/documents/seekers/$(d.contextId)).data.ownerUid == other
            && 'dm' in get(userPath(request.auth.uid)).data.roles);
    }

    function validNewChat(chatId) {
      let d = request.resource.data;
      let other = chatOther(d.members);
      return d.keys().hasOnly(['members', 'nicknames', 'contextType', 'contextId', 'contextTitle',
                               'lastMessage', 'lastSenderUid', 'readAt', 'closed', 'deletedUids',
                               'createdAt', 'updatedAt'])
        && d.members is list && d.members.size() == 2
        && request.auth.uid in d.members && other != request.auth.uid
        && d.members[0] < d.members[1]
        && chatId == d.members[0] + '_' + d.members[1]
        && d.nicknames is map && d.nicknames.keys().hasOnly(d.members)
        // Your own name must be real; the other name is only a display hint for you.
        && d.nicknames[request.auth.uid] == get(userPath(request.auth.uid)).data.nickname
        && d.nicknames[other] is string && d.nicknames[other].size() <= 30
        && d.contextId is string && d.contextTitle is string && d.contextTitle.size() <= 80
        && validChatContext(d, other)
        && !hasBlocked(other, request.auth.uid) && !hasBlocked(request.auth.uid, other)
        && d.lastMessage == '' && d.lastSenderUid == null
        && d.readAt is map && d.readAt.size() == 0
        && d.closed == false && d.deletedUids is list && d.deletedUids.size() == 0
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    // Sending (last message summary) and/or marking your own read time.
    function chatActivityUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'readAt'])
        && d.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
        && (!('readAt' in changed) || d.readAt[request.auth.uid] == request.time)
        && (!changed.hasAny(['lastMessage', 'lastSenderUid', 'updatedAt'])
            || (!resource.data.closed
                && d.lastSenderUid == request.auth.uid
                && d.updatedAt == request.time
                && d.lastMessage is string && d.lastMessage.size() <= 110));
    }

    // Deleting your account: close the chat and drop your nickname; history stays.
    function chatArchiveUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['closed', 'deletedUids', 'nicknames'])
        && d.closed == true
        && d.deletedUids.toSet() == resource.data.deletedUids.toSet().union([request.auth.uid].toSet())
        && d.nicknames.diff(resource.data.nicknames).affectedKeys().hasOnly([request.auth.uid])
        && d.nicknames[request.auth.uid] == '';
    }

    function validMessage(chatId) {
      let d = request.resource.data;
      let chat = get(chatPath(chatId)).data;
      let other = chatOther(chat.members);
      return d.keys().hasOnly(['senderUid', 'text', 'createdAt'])
        && request.auth.uid in chat.members
        && !chat.closed
        && !hasBlocked(other, request.auth.uid) && !hasBlocked(request.auth.uid, other)
        && d.senderUid == request.auth.uid
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
        && d.createdAt == request.time;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validNewChat(chatId);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && (chatActivityUpdate() || chatArchiveUpdate());

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn() && validMessage(chatId);
      }
    }

    // Reading applications (single docs and collection-group queries):
    // the applicant and the game owner only. Queries must filter on
    // applicantUid or gameOwnerUid for these rules to allow them.
    match /{path=**}/applications/{applicantUid} {
      allow get: if signedIn()
        && (request.auth.uid == applicantUid || resource.data.gameOwnerUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.applicantUid == request.auth.uid
            || resource.data.gameOwnerUid == request.auth.uid);
    }

    // Nickname reservations: nicknames/{key} = { uid }. Key = nickKey(nickname).
    match /nicknames/{key} {
      allow read: if signedIn();
      // Only reserve the nickname your profile uses after this write.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && validNickname(getAfter(userPath(request.auth.uid)).data.nickname)
        && nickKey(getAfter(userPath(request.auth.uid)).data.nickname) == key;
      // Release only a nickname your profile no longer uses.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid))
            || nickKey(getAfter(userPath(request.auth.uid)).data.nickname) != key);
    }
  }
}
